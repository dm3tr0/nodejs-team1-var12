<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Про студента</title>
</head>
<body>
    <h1>Інформація про студента: <%= student.name %></h1>
    <p><strong>Роль у бригаді:</strong> <%= student.role %></p>
    
    <h3>Ключові навички:</h3>
    <ul>
        <% student.skills.forEach(function(skill) { %>
            <li><%= skill %></li>
        <% }); %>
    </ul>

    <br>
    <a href="/">⬅ Повернутися на головну</a>
</body>
</html>